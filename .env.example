# Copy this file to ".env" (git-ignored) and adjust the values for your local setup.
# docker-compose and application.properties both read these via environment variables,
# falling back to the defaults below if unset.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=crypto_db
DB_USERNAME=cryptouser
DB_PASSWORD=crypto123

# Optional: CoinGecko demo API key (x-cg-demo-api-key header). Not required for the public
# API, but authenticated requests get more generous rate limits than anonymous ones.
COINGECKO_API_KEY=
